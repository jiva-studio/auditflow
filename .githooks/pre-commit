#!/usr/bin/env bash
set -e

# 1. Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Helper to run commands in environment
run_in_env() {
  local cmd="$1"
  if command -v go >/dev/null 2>&1 && command -v golangci-lint >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    eval "$cmd"
  elif command -v nix-shell >/dev/null 2>&1; then
    nix-shell -p gnumake go golangci-lint python3 --run "$cmd"
  else
    eval "$cmd"
  fi
}

# 2. Check formatting for staged Go files
GO_FILES=$(echo "$STAGED_FILES" | grep '\.go$' | tr '\n' ' ' || true)
if [ -n "$GO_FILES" ]; then
  UNFORMATTED=$(run_in_env "gofmt -l $GO_FILES" || true)
  if [ -n "$UNFORMATTED" ]; then
    echo "❌ Error: The following staged Go files are not formatted with gofmt:"
    echo "$UNFORMATTED"
    echo "Please format them with 'make fmt' and stage again."
    exit 1
  fi
fi

# 3. Targeted module checks
if echo "$STAGED_FILES" | grep -q -E '^(libs/domain/|scripts/guards/domain/)'; then
  echo "🔍 [pre-commit] Checking libs/domain..."
  run_in_env "make domain_guard domain_test domain_lint"
fi

if echo "$STAGED_FILES" | grep -q -E '^(modules/agent/|scripts/guards/agent/)'; then
  echo "🔍 [pre-commit] Checking modules/agent..."
  run_in_env "make agent_test agent_lint"
fi

if echo "$STAGED_FILES" | grep -q -E '^(modules/server/|scripts/guards/server/)'; then
  echo "🔍 [pre-commit] Checking modules/server..."
  run_in_env "make server_test server_lint"
fi

if echo "$STAGED_FILES" | grep -q -E '^(modules/streamer/|scripts/guards/streamer/)'; then
  echo "🔍 [pre-commit] Checking modules/streamer..."
  run_in_env "make streamer_test streamer_lint"
fi

if echo "$STAGED_FILES" | grep -q '^tests/e2e/'; then
  echo "🔍 [pre-commit] Checking tests/e2e..."
  run_in_env "make e2e_test"
fi
