#!/usr/bin/env bash
set -e

# 1. Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Helper to run commands in environment
run_in_env() {
  local cmd="$1"
  if command -v go >/dev/null 2>&1 && command -v golangci-lint >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    eval "$cmd"
  elif command -v nix-shell >/dev/null 2>&1; then
    nix-shell -p gnumake go golangci-lint python3 --run "$cmd"
  else
    eval "$cmd"
  fi
}

# 2. Check formatting for staged Go files
GO_FILES=$(echo "$STAGED_FILES" | grep '\.go$' | tr '\n' ' ' || true)
if [ -n "$GO_FILES" ]; then
  UNFORMATTED=$(run_in_env "gofmt -l $GO_FILES" || true)
  if [ -n "$UNFORMATTED" ]; then
    echo "❌ Error: The following staged Go files are not formatted with gofmt:"
    echo "$UNFORMATTED"
    echo "Please format them with 'make fmt' and stage again."
    exit 1
  fi
fi

# 3. Targeted module checks
TARGET_MAP=(
  "modules/libs/domain/:make domain_guard domain_test domain_lint"
  "scripts/guards/domain/:make domain_guard domain_test domain_lint"
  "modules/libs/protocol/:make protocol_test protocol_lint"
  "modules/libs/rules/:make rules_test rules_lint"
  "modules/libs/telemetry/:make telemetry_test telemetry_lint"
  "modules/apps/agent/:make agent_test agent_lint"
  "scripts/guards/agent/:make agent_test agent_lint"
  "modules/apps/server/:make server_test server_lint"
  "scripts/guards/server/:make server_test server_lint"
  "modules/apps/streamer/:make streamer_test streamer_lint"
  "scripts/guards/streamer/:make streamer_test streamer_lint"
  "tests/e2e/:make e2e_test"
)

EXECUTED_COMMANDS=()

for entry in "${TARGET_MAP[@]}"; do
  pattern="${entry%%:*}"
  cmd="${entry#*:}"

  if echo "$STAGED_FILES" | grep -q "^$pattern"; then
    if [[ ! " ${EXECUTED_COMMANDS[*]} " =~ " ${cmd} " ]]; then
      EXECUTED_COMMANDS+=("$cmd")
      echo "🔍 [pre-commit] Checking $pattern..."
      run_in_env "$cmd"
    fi
  fi
done
